{
  "name": "gbif-community-components",
  "version": "0.0.1",
  "description": "Community web components that expose GBIF-mediated content for reuse on any website.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --open /examples/",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:browser": "node test/browser/smoke.cjs",
    "test:browser:components": "node test/browser/components.cjs",
    "test:all": "npm test && npm run test:browser:components"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "vite": "^8.3.8"
  }
}
